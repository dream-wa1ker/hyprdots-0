#!/usr/bin/env bash
#
# profile-switch: switch Hyprdots profiles.
#
# Usage:
#   profile-switch
#   profile-switch <profile>
#   profile-switch --list
#   profile-switch --help

set -Eeuo pipefail
IFS=$'\n\t'

readonly REPO_ROOT="${HOME}/Projects/hyprdots-0"
readonly CHEZMOI_SOURCE="${REPO_ROOT}/dots"
readonly PROFILES_DIR="${REPO_ROOT}/profiles"

readonly OBSIDIAN_VAULT="${HOME}/Workspace/notes/obsidian/0000"
readonly OBSIDIAN_TARGET="${OBSIDIAN_VAULT}/.obsidian/appearance.json"
readonly NOCTALIA_TARGET="${HOME}/.local/state/noctalia/settings.toml"

PROGRAM="${0##*/}"

log() {
    printf '[%s] %s\n' "$PROGRAM" "$*"
}

die() {
    printf '[%s] error: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage:
  ${PROGRAM}             Select a profile using Fuzzel
  ${PROGRAM} <profile>   Apply a specific profile
  ${PROGRAM} --list      List available profiles
  ${PROGRAM} --help      Show this help

Profiles directory:
  ${PROFILES_DIR}
EOF
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "Required command not found: $1"
}

validate_profile_name() {
    [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] ||
        die "Invalid profile name: $1"
}

list_profiles() {
    [[ -d "$PROFILES_DIR" ]] ||
        die "Profiles directory not found: $PROFILES_DIR"

    find "$PROFILES_DIR" \
        -mindepth 1 -maxdepth 1 -type d \
        -printf '%f\n' |
        sort
}

select_profile() {
    require_command fuzzel

    local selected

    selected="$(
        list_profiles |
            fuzzel --dmenu \
                --prompt 'Profile  ' \
                --width 30
    )" || return 1

    [[ -n "$selected" ]] || return 1

    printf '%s\n' "$selected"
}

validate_profile() {
    local profile="$1"
    local profile_dir="${PROFILES_DIR}/${profile}"

    [[ -d "$profile_dir" ]] ||
        die "Profile not found: $profile_dir"

    [[ -s "${profile_dir}/obsidian/appearance.json" ]] ||
        die "Missing or empty file: ${profile_dir}/obsidian/appearance.json"

    [[ -s "${profile_dir}/noctalia/settings.toml" ]] ||
        die "Missing or empty file: ${profile_dir}/noctalia/settings.toml"

    if command -v jq >/dev/null 2>&1; then
        jq empty "${profile_dir}/obsidian/appearance.json" >/dev/null ||
            die "Invalid Obsidian JSON in profile: $profile"
    fi
}

validate_destinations() {
    [[ -d "$REPO_ROOT" ]] ||
        die "Repository not found: $REPO_ROOT"

    [[ -d "$CHEZMOI_SOURCE" ]] ||
        die "chezmoi source not found: $CHEZMOI_SOURCE"

    [[ -d "${OBSIDIAN_VAULT}/.obsidian" ]] ||
        die "Obsidian configuration directory not found."

    [[ -d "$(dirname "$NOCTALIA_TARGET")" ]] ||
        die "Noctalia state directory not found."

    [[ -w "${OBSIDIAN_VAULT}/.obsidian" ]] ||
        die "Obsidian configuration directory is not writable."

    [[ -w "$(dirname "$NOCTALIA_TARGET")" ]] ||
        die "Noctalia state directory is not writable."
}

apply_profile() {
    local profile="$1"
    local profile_dir="${PROFILES_DIR}/${profile}"
    local post_apply="${profile_dir}/post-apply.sh"

    validate_profile_name "$profile"
    validate_profile "$profile"
    validate_destinations

    require_command cp
    require_command chezmoi
    require_command noctalia

    log "Applying profile: $profile"

    # Copy profile settings.
    cp -- \
        "${profile_dir}/obsidian/appearance.json" \
        "$OBSIDIAN_TARGET"

    cp -- \
        "${profile_dir}/noctalia/settings.toml" \
        "$NOCTALIA_TARGET"

    # Apply the selected profile in Noctalia.
    noctalia msg config-reload
    noctalia msg templates-apply

    sleep 5

    # Run the profile-specific post-apply hook, if present.
    if [[ -f "$post_apply" ]]; then
        log "Running profile hook: $post_apply"
        bash "$post_apply"
    fi

    # Import the final active configuration into chezmoi.
    chezmoi --source "$CHEZMOI_SOURCE" add -- \
        "$HOME/.config/btop/themes/noctalia.theme" \
        "$HOME/.config/cava/themes/noctalia" \
        "$HOME/.config/fastfetch/themes/noctalia.jsonc" \
        "$HOME/.config/foot/themes/noctalia" \
        "$HOME/.config/fuzzel/themes/noctalia" \
        "$HOME/.config/hypr/noctalia.lua" \
        "$HOME/.config/kitty/themes/noctalia.conf" \
        "$HOME/.config/nvim/lua/matugen.lua" \
        "$HOME/.config/starship.toml" \
        "$HOME/.local/state/noctalia/settings.toml" \
        "$HOME/.config/hypr/noctalia.lua"

    log "Profile '$profile' activated."
}

main() {
    local profile="${1:-}"

    (($# <= 1)) || die "Expected at most one argument."

    case "$profile" in
    --help | -h)
        usage
        return 0
        ;;
    --list | -l)
        list_profiles
        return 0
        ;;
    --*)
        die "Unknown option: $profile"
        ;;
    "")
        profile="$(select_profile)" || {
            log "Profile selection cancelled."
            return 0
        }
        ;;
    esac

    apply_profile "$profile"
}

main "$@"
